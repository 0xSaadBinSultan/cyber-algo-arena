PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE_NAME=cyber_algo_arena
ARENA_ADMIN_USERNAME=admin
# Set a unique value of at least 12 characters before first startup.
ARENA_ADMIN_PASSWORD=

# Gemini AI Tutor (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CP judge. For production, point this at an authorized/self-hosted Piston-compatible service.
PISTON_URL=

# Hosted cloud judge (Judge0 CE - public cloud endpoint https://ce.judge0.com works without key)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
# Optional bearer token for an authorized Piston endpoint
PISTON_API_KEY=
# External catalog imports are opt-in. Imported problems are references, not locally judged.
ARENA_AUTO_SYNC=false
