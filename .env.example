# Local development only. Cloud deployments must use APP_ENV=production and a remote replica set.
# The application reads the process environment; this file is not loaded automatically.
APP_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE_NAME=cyber_algo_arena
ARENA_ADMIN_USERNAME=admin
# Set a unique value of at least 12 characters before first startup.
ARENA_ADMIN_PASSWORD=

# Gemini AI Tutor (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CP judge. For production, point this at an authorized/self-hosted Piston-compatible service.
PISTON_URL=
